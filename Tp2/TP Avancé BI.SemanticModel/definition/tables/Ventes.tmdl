table Ventes
	lineageTag: 3c08a4a4-c2da-4820-810d-e1f224abd5b1

	measure VentesBrutes$ = SUMX(Ventes, RELATED(DimProduit1[Prix unitaire]) * Ventes[Unités vendues])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 58d6d948-f4ec-450e-be67-012f5f67b1c7

	measure VentesBrutes$AnPrec = CALCULATE([VentesBrutes$], DATEADD(DimDates[Date], -1, YEAR))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 72034423-24a9-415c-8b5f-7622f9fbef71

	measure VentesBrutes$YTD = CALCULATE([VentesBrutes$], DATESYTD(DimDates[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: eedb103f-abde-41d5-a62e-d234d09a02c9

	measure NbTransactions = COUNTROWS(Ventes)
		formatString: #,0
		lineageTag: 2917328c-0a90-4ebe-a245-aedceaca09e3

	measure NbTransactionsAnPrec = CALCULATE([NbTransactions], DATEADD(DimDates[Date], -1, YEAR))
		formatString: #,0
		lineageTag: a96ff4f4-bd1a-4b71-acfc-0a8799223aea

	measure NbTransactionsYTD = CALCULATE([NbTransactions], DATESYTD(DimDates[Date]))
		formatString: #,0
		lineageTag: 7dc499fb-3447-4975-891d-9a92a42bb264

	measure Écart$VentesBrutesAnPrec = [VentesBrutes$] - [VentesBrutes$AnPrec]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 8a259d77-671e-4579-8d84-deada57fc1f1

	measure ÉcartNbTransactionsAnPrec = [NbTransactions] - [NbTransactionsAnPrec]
		formatString: #,0
		lineageTag: 3c13ef37-1208-4589-bb95-b0c6f2ada6ab

	measure Écart%NbTransactionsAnPrec = DIVIDE([ÉcartNbTransactionsAnPrec], [NbTransactionsAnPrec], 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 13767db3-6f56-4c87-9169-67b268051bf9

	measure Écart%VentesBrutes$AnPrec = DIVIDE([Écart$VentesBrutesAnPrec], [VentesBrutes$AnPrec], 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d469ef53-d94b-4ef8-892c-650c39a2813f

