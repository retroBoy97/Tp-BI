	column 'NOMBRE DE CHAMBRES (compartiments)' =
			IF(
				ISBLANK('Hébergement'[NOMBRE DE CHAMBRES]),
				BLANK(),
				INT('Hébergement'[NOMBRE DE CHAMBRES] / 25) * 25
			)
		formatString: 0
		lineageTag: 34045185-8712-47a7-9ae7-b1bf3ccaf6be
		summarizeBy: none

